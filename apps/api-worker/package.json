{
  "name": "api-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/ensure-dev-env.mjs && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run && vitest run --config vitest.do.config.ts",
    "test:do": "vitest run --config vitest.do.config.ts",
    "db:schema": "wrangler d1 execute luotdi-db --local --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute luotdi-db --local --file=src/db/seed.sql",
    "db:reset": "node ./scripts/reset-local-d1.mjs"
  },
  "dependencies": {
    "@luotdi/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "vitest": "~3.2.4",
    "wrangler": "^4.54.0"
  }
}
