# Copy to .env.local for local overrides. Leave VITE_API_BASE EMPTY for `pnpm dev`
# (relative /api -> Vite proxy -> wrangler dev on 127.0.0.1:8787).
# Setting it to the production URL here makes local dev hit prod (404 on /api/auth/dev).
VITE_API_BASE=
# Put the real Worker URL for Zalo builds in .env.production instead:
#   VITE_API_BASE=https://api.luotdi.vn
# "1" forces the browser dev login (/api/auth/dev) outside Zalo in non-dev builds.
VITE_SKIP_ZALO_AUTH=
# Optional: Zalo OA id for the "Quan tâm OA" button on the thank-you screen.
VITE_ZALO_OA_ID=
